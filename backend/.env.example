# Server
PORT=5000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devping?schema=public"

# Redis (BullMQ ping queue/worker) — required for monitoring to run
REDIS_URL=redis://localhost:6379

# Set to "false" on the API service when running a dedicated worker process
# (npm run start:worker). Defaults to running the worker in-process.
RUN_WORKER=true

# Auth
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Email alerts (Resend) — get a key at https://resend.com/api-keys
# If RESEND_API_KEY is unset, alerts are skipped (logged) and the pinger still runs.
RESEND_API_KEY=
EMAIL_FROM="DevPing Alerts <alerts@devping.io>"

# Public URL of the frontend, used for links inside alert emails
APP_URL=http://localhost:3000

# AI anomaly detection (Groq) — get a key at https://console.groq.com/keys
# If GROQ_API_KEY is unset, AI analysis is disabled (endpoint returns 503).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
